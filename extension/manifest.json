{
  "manifest_version": 3,
  "name": "Taskmaster Site Blocker",
  "version": "1.0.0",
  "description": "Bloqueador de sitios web integrado con Taskmaster para máxima productividad.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:47700/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo-icono.png",
      "48": "icons/logo-icono.png",
      "128": "icons/logo-icono.png"
    }
  },
  "icons": {
    "16": "icons/logo-icono.png",
    "48": "icons/logo-icono.png",
    "128": "icons/logo-icono.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
